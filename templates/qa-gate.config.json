{
  "$schema": "https://raw.githubusercontent.com/limbpuma/qa-gate/main/schemas/config.schema.json",
  "version": 1,
  "gateVersion": "",
  "profile": "auto",
  "profiles": {
    "sandbox": {
      "skip": [
        "coverage",
        "integration",
        "semgrep",
        "trivy-fs",
        "ai-register",
        "pa11y",
        "lighthouse",
        "e2e",
        "nuclei",
        "axe",
        "legal",
        "evidence",
        "docker-build",
        "trivy-image",
        "sbom"
      ],
      "sitemapMaxPages": 0
    },
    "portfolio-demo": {
      "skip": [
        "nuclei",
        "lighthouse"
      ],
      "lighthouse": {
        "runs": 1,
        "formFactors": [
          "mobile"
        ]
      },
      "sitemapMaxPages": 10
    },
    "mvp-client": {
      "skip": [
        "nuclei"
      ],
      "lighthouse": {
        "runs": 1,
        "formFactors": [
          "mobile"
        ]
      },
      "sitemapMaxPages": 30,
      "commitHistory": true
    },
    "production": {
      "skip": [],
      "sitemapMaxPages": 100,
      "commitHistory": true
    }
  },
  "stack": "auto",
  "git": {
    "base": "auto"
  },
  "commands": {
    "node": {
      "typecheck": "auto",
      "lint": "auto",
      "unit": "auto",
      "coverage": "auto",
      "integration": "auto",
      "e2e": "auto"
    },
    "go": {
      "build": "go build ./... && go vet ./...",
      "unit": "go test ./... -count=1 -coverprofile=qa-report/_logs/go-cover.out",
      "vuln": "govulncheck ./..."
    },
    "python": {
      "lint": "ruff check . && ruff format --check .",
      "unit": "pytest -p pytest_cov --cov --cov-report=json:qa-report/_logs/coverage.json -q",
      "env": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
      }
    }
  },
  "coverage": {
    "min": 80,
    "ratchet": true,
    "ratchetFile": "qa-report/coverage-ratchet.json",
    "tolerance": 0.2
  },
  "secrets": {
    "excludes": [
      "node_modules",
      ".git",
      "qa-report",
      "dist",
      ".next",
      "coverage"
    ]
  },
  "waivers": [],
  "semgrep": {
    "image": "semgrep/semgrep:1.130.0",
    "rulesets": [
      "p/secrets",
      "p/owasp-top-ten"
    ],
    "stackRulesets": {
      "node": [
        "p/typescript",
        "p/javascript",
        "p/react",
        "p/nextjs",
        "p/nodejs"
      ],
      "go": [
        "p/golang",
        "p/gosec"
      ],
      "python": [
        "p/python",
        "p/bandit"
      ]
    },
    "blockOn": "ERROR",
    "changedOnly": true
  },
  "trivy": {
    "image": "aquasec/trivy:0.58.1",
    "severity": "HIGH,CRITICAL",
    "ignoreUnfixed": true,
    "scanners": "vuln,misconfig",
    "timeoutMin": 15,
    "skipDirs": [
      "**/node_modules",
      "**/.git",
      "**/.next",
      "**/.next-*",
      "**/dist",
      "**/build",
      "**/coverage",
      "**/qa-report",
      "**/.lighthouse",
      "**/.lighthouseci",
      "**/vendor",
      "**/__pycache__",
      "**/.venv",
      "**/target",
      "**/.turbo",
      "**/.cache"
    ]
  },
  "audit": {
    "level": "high"
  },
  "build": {
    "dockerfile": "auto",
    "context": ".",
    "target": ""
  },
  "web": {
    "baseUrl": "",
    "paths": [
      "/"
    ],
    "sitemapMaxPages": 10,
    "startCommand": "",
    "readyPath": "/",
    "startTimeoutSec": 90,
    "lighthouse": {
      "runs": 3,
      "formFactors": [
        "mobile",
        "desktop"
      ],
      "thresholds": {
        "performance": 80,
        "accessibility": 95,
        "best-practices": 90,
        "seo": 90
      }
    },
    "pa11y": {
      "standard": "WCAG2AA",
      "runners": [
        "axe",
        "htmlcs"
      ]
    },
    "axe": {
      "tags": [
        "wcag2a",
        "wcag2aa",
        "wcag21a",
        "wcag21aa",
        "EN-301-549"
      ],
      "warnTags": [
        "wcag22aa"
      ],
      "blockImpacts": [
        "serious",
        "critical"
      ]
    },
    "nuclei": {
      "enabled": true,
      "image": "projectdiscovery/nuclei:v3.4.10",
      "templates": [
        "http/misconfiguration",
        "http/exposures"
      ],
      "severity": "high,critical"
    }
  },
  "legal": {
    "impressumPath": "/impressum",
    "datenschutzPath": "/datenschutz",
    "barrierefreiheitPath": "/barrierefreiheit",
    "agbPath": "/agb",
    "widerrufPath": "/widerruf",
    "checkoutPath": "",
    "sector": "",
    "features": [],
    "allowedHosts": [],
    "consent": {
      "required": false,
      "acceptText": "Akzeptieren|Alle akzeptieren|Zustimmen|Accept",
      "rejectText": "Ablehnen|Nur notwendige|Reject",
      "settingsText": "Cookie-Einstellungen|Cookie Einstellungen|Datenschutzeinstellungen|Einwilligung widerrufen|Privatsphäre-Einstellungen|Cookie settings|Privacy settings"
    },
    "requiredHeaders": [
      "content-security-policy",
      "x-content-type-options",
      "x-frame-options",
      "referrer-policy"
    ],
    "impressum": {
      "requiredPatterns": []
    },
    "ai": {
      "enabled": "auto",
      "chatSelector": "",
      "disclosureText": "KI|künstliche Intelligenz|automatisiert|Chatbot|Bot|AI",
      "providers": [],
      "registerPath": "docs/AI-ACT-REGISTER.md"
    }
  },
  "report": {
    "dir": "qa-report",
    "keepLogs": 10,
    "history": true,
    "commitHistory": false
  }
}
